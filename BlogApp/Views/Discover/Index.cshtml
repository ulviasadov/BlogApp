@{
    ViewBag.Title = "Discover";
}

@model List<BlogDto>;

<h1 class="container">Hello form discover!</h1>

    @{
        foreach (var blog in Model)
        {
            <div class="container w-25 mb-1" style="border: 1px solid black; border-radius: 8px;">
                <div class="pt-1 d-flex align-items-center gap-2">
                    <div class="d-flex" style="width: 25px; height: 25px; border: 1px solid #000; border-radius: 50%; overflow: hidden;">
                        <img src="@blog.ImageUrl" />
                    </div>
                    <h6>@blog.UserName</h6>
                </div>
                <div style="border-bottom: 1px solid gray">
                    <h4>@blog.Title</h4>
                </div>
                <div>
                    <p>@blog.BodyText</p>
                </div>
            </div>
        }
    }